# Base URL of Member 2's backend (no trailing slash needed).
# Local mock:        http://localhost:8000
# Deployed backend:  https://poshanscan-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Reference object the worker places beside the arm.
# Must match what the CV service expects: aruco | coin | card
VITE_REFERENCE_TYPE=aruco
VITE_REFERENCE_SIZE_MM=50

# Client-side blur check. Lower = more permissive. Tune with real test photos.
VITE_MIN_SHARPNESS=40
